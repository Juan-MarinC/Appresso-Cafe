{"step_index":161,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-31T16:44:51Z","content":"Created At: 2026-08-31T11:44:51-05:00\nCompleted At: 2026-08-31T11:44:51-05:00\nFile Path: `file:///C:/Users/juan2/.gemini/antigravity/brain/23eabdbc-225e-4c28-8288-af4260aef6b7/appresso_analysis/app.py`\nTotal Lines: 100\nTotal Bytes: 3661\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import uvicorn\n2: from fastapi import FastAPI, Request, Form\n3: from fastapi.responses import HTMLResponse, FileResponse, JSONResponse\n4: from pathlib import Path\n5: import json\n6: \n7: from appresso_analysis.orders import generate_orders, Order\n8: from appresso_analysis.algorithms import find_order_linear, total_products, recursive_analyze\n9: from appresso_analysis.counter import OperationCounter\n10: from appresso_analysis.analysis import run_experiments\n11: from appresso_analysis.growth import weeks_to_reach\n12: from appresso_analysis.regression import predict_sales_numpy\n13: from appresso_analysis.storage import init_db, insert_orders, get_all_orders\n14: \n15: app = FastAPI()\n16: \n17: HTML = \"\"\"\n18: <!DOCTYPE html>\n19: <html>\n20: <head><title>Appresso Café Analyzer</title></head>\n21: <body>\n22: <h1>Appresso Café Analyzer</h1>\n23: <form action=\"/run\" method=\"post\">\n24:   <label for=\"size\">Tamaño de la lista de pedidos:</label>\n25:   <select name=\"size\" id=\"size\">\n26:     <option value=\"10\">10</option>\n27:     <option value=\"100\">100</option>\n28:     <option value=\"1000\">1 000</option>\n29:     <option value=\"10000\">10 000</option>\n30:     <option value=\"100000\">100 000</option>\n31:   </select>\n32:   <br/><br/>\n33:   <button type=\"submit\">Ejecutar análisis</button>\n34: </form>\n35: </body>\n36: </html>\n37: \"\"\"\n38: \n39: @app.on_event(\"startup\")\n40: async def startup_event():\n41:     # initialise SQLite DB (creates file if missing)\n42:     init_db()\n43: \n44: @app.get(\"/\", response_class=HTMLResponse)\n45: async def read_root():\n46:     return HTML\n47: \n48: @app.post(\"/run\")\n49: async def run_analysis(request: Request, size: int = Form(...)):\n50:     # Generate orders\n51:     orders = generate_orders(size)\n52:     # Persist to SQLite (optional, also keep in JSON for quick view)\n53:     insert_orders(orders)\n54:     # Run core algorithms and count operations\n55:     counter = OperationCounter()\n56:     target_id = orders[0].order_id if orders else 0\n57:     find_order_linear(orders, target_id, counter)\n58:     find_ops = counter.comparisons\n59:     counter.reset()\n60:     total_products(orders, counter)\n61:     total_ops = counter.additions\n62:     counter.reset()\n63:     recursive_analyze(orders, 0, counter)\n64:     rec_calls = counter.calls\n65:     rec_adds = counter.additions\n66:     # Growth model (client doubles each week, start=2)\n67:     growth_weeks = {target: weeks_to_reach(target, start=2, factor=2) for target in [42, 72, 120]}\n68:     # Simple sales prediction using NumPy linear regression on simulated daily totals\n69:     daily_totals = [order.total_quantity() if isinstance(order, Order) else sum(q for _, q in order[\"products\"]) for order in orders]\n70:     pred_2_5 = predict_sales_numpy(daily_totals, days_ahead=2.5)\n71:     pred_7 = predict_sales_numpy(daily_totals, days_ahead=7)\n72:     # Write operation counts to CSV (single row)\n73:     out_path = Path(\"operation_counts.csv\")\n74:     out_path.write_text(\n75:         \"size,find_comparisons,total_additions,recursive_calls,recursive_additions\\n\"\n76:         f\"{size},{find_ops},{total_ops},{rec_calls},{rec_adds}\\n\"\n77:     )\n78:     response = {\n79:         \"size\": size,\n80:         \"find_comparisons\": find_ops,\n81:         \"total_additions\": total_ops,\n82:         \"recursive_calls\": rec_calls,\n83:         \"recursive_additions\": rec_adds,\n84:         \"growth_weeks\": growth_weeks,\n85:         \"prediction_2_5_days\": pred_2_5,\n86:         \"prediction_7_days\": pred_7,\n87:         \"csv_download\": \"/download/operation_counts.csv\"\n88:     }\n89:     return JSONResponse(content=response)\n90: \n91: @app.get(\"/download/{filename}\")\n92: async def download_file(filename: str):\n93:     file_path = Path(filename)\n94:     if not file_path.is_file():\n95:         return JSONResponse(content={\"error\": \"File not found\"}, status_code=404)\n96:     return FileResponse(path=file_path, filename=filename, media_type=\"text/csv\")\n97: \n98: if __name__ == \"__main__\":\n99:     uvicorn.run(\"app:app\", host=\"0.0.0.0\", port=8000, reload=False)\n100: \nThe above content shows the entire, complete file contents of the requested file.\n"}
